{
  "name": "letrado",
  "version": "0.1.0",
  "description": "Agente de terminal para abogados: legislación y jurisprudencia española con herramientas de trabajo sobre documentos",
  "type": "module",
  "bin": {
    "letrado": "bin/letrado.js"
  },
  "files": [
    "bin",
    "dist",
    "resources",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "PI_CODING_AGENT_DIR=./.dev-agent node --import tsx src/cli.ts",
    "dev:print": "PI_CODING_AGENT_DIR=./.dev-agent node --import tsx src/cli.ts -p",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "typebox": "1.3.27",
    "unpdf": "^1.8.1",
    "mammoth": "^1.13.0",
    "docx": "^9.8.1",
    "marked": "^18.0.14",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "node-html-markdown": "^1.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.0.3",
    "zod": "^4.6"
  }
}
